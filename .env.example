# Copy this file to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver,aped.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://aped.pythonanywhere.com
DJANGO_TIME_ZONE=Africa/Nairobi

# Set DATABASE_URL to a managed PostgreSQL connection in production.
# DATABASE_URL=postgresql://user:password@host:5432/database

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=APED Monitoring <noreply@example.com>
